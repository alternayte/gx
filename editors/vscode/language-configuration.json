{
  "comments": {
    "lineComment": "//",
    "blockComment": ["{/*", "*/}"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "<(?!\\/|!|[^>]+\\/>)[^>]+>$|^\\s*(if|for|switch|case|default).*\\{\\s*$|\\($",
    "decreaseIndentPattern": "^\\s*(\\}|/\\)|\\]|</)"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|\\$[A-Za-z_][A-Za-z0-9_]*|#[A-Za-z_][A-Za-z0-9_]*"
}
