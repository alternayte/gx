{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gx",
  "scopeName": "source.gx",
  "fileTypes": [
    "gx"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#header"
    },
    {
      "include": "#rawScripts"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#statements"
    },
    {
      "include": "#goExpr"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.gx",
          "begin": "\\{/\\*",
          "end": "\\*/\\}"
        },
        {
          "name": "comment.block.html.gx",
          "begin": "<!--",
          "end": "-->"
        },
        {
          "name": "comment.line.double-slash.gx",
          "match": "^\\s*//.*$"
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "name": "meta.embedded.block.go",
          "begin": "^\\s*(?=import\\s*\\(\\s*$)",
          "end": "^\\s*\\)",
          "patterns": [
            {
              "include": "#goCode"
            }
          ]
        },
        {
          "match": "^\\s*((?:package|import)\\b.*)$",
          "captures": {
            "1": {
              "name": "meta.embedded.block.go",
              "patterns": [
                {
                  "include": "#goLine"
                }
              ]
            }
          }
        },
        {
          "name": "meta.embedded.block.go",
          "begin": "^\\s*(props|signals)\\s*\\{",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.gx"
            }
          },
          "end": "^\\s*\\}",
          "patterns": [
            {
              "name": "comment.line.double-slash.gx",
              "match": "//.*$"
            },
            {
              "include": "#goCode"
            }
          ]
        }
      ]
    },
    "rawScripts": {
      "patterns": [
        {
          "name": "meta.embedded.block.typescript",
          "begin": "(<script\\b[^>]*\\blang=[\"']ts[\"'][^>]*>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            }
          },
          "end": "(</script>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "source.ts"
            }
          ]
        },
        {
          "name": "meta.embedded.block.javascript",
          "begin": "(<script\\b[^>]*>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            }
          },
          "end": "(</script>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "name": "meta.embedded.block.css",
          "begin": "(<style\\b[^>]*>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            }
          },
          "end": "(</style>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "meta.tag.component.gx",
          "begin": "(</?)((?:[a-z][A-Za-z0-9_]*\\.)?[A-Z][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.component.gx"
            }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        {
          "name": "meta.tag.custom.gx",
          "begin": "(</?)([a-z][a-z0-9]*-[a-z0-9-]*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.custom.gx"
            }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        {
          "name": "meta.tag.gx",
          "begin": "(</?)([a-z][a-z0-9]*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.gx"
            }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        {
          "name": "meta.tag.slot.gx",
          "match": "(</?)(:[a-zA-Z][A-Za-z0-9_]*)(\\s*/?>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.slot.gx"
            },
            "3": {
              "name": "punctuation.definition.tag.end.html"
            }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "include": "#fragments"
        },
        {
          "include": "#directives"
        },
        {
          "name": "entity.other.attribute-name.gx",
          "match": "[a-zA-Z_:@][-a-zA-Z0-9_:.]*"
        },
        {
          "include": "#goExpr"
        },
        {
          "name": "string.quoted.double.gx",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.gx",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.gx",
          "match": "\\b(show|text|key|transition|active)\\b(?=\\s*=)"
        },
        {
          "name": "keyword.control.directive.gx",
          "match": "\\b(bind|class|attr):[^\\s=/>]+"
        },
        {
          "name": "keyword.control.directive.gx",
          "match": "\\bon:[a-z-]+(?:\\([^)]*\\))?(?:\\.[a-z]+(?:\\([^)]*\\))?)*"
        }
      ]
    },
    "fragments": {
      "patterns": [
        {
          "begin": "(#[A-Za-z_][A-Za-z0-9_]*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.fragment.gx"
            }
          },
          "end": "\\)",
          "contentName": "meta.embedded.block.go",
          "patterns": [
            {
              "include": "#goCode"
            }
          ]
        },
        {
          "name": "entity.name.function.fragment.gx",
          "match": "#[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "match": "^\\s*((?:\\}\\s*else\\b|if\\b|for\\b|switch\\b).*\\{)\\s*$",
          "captures": {
            "1": {
              "name": "meta.embedded.block.go",
              "patterns": [
                {
                  "include": "#goLine"
                }
              ]
            }
          }
        },
        {
          "match": "^\\s*((?:case\\b.*|default\\s*):)\\s*$",
          "captures": {
            "1": {
              "name": "meta.embedded.block.go",
              "patterns": [
                {
                  "include": "#goLine"
                }
              ]
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_, ]*:=.*)$",
          "captures": {
            "1": {
              "name": "meta.embedded.block.go",
              "patterns": [
                {
                  "include": "#goLine"
                }
              ]
            }
          }
        },
        {
          "match": "^\\s*(\\})\\s*$",
          "captures": {
            "1": {
              "name": "meta.embedded.block.go"
            }
          }
        }
      ]
    },
    "goExpr": {
      "name": "meta.embedded.block.go",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#goCode"
        }
      ]
    },
    "goCode": {
      "patterns": [
        {
          "include": "#signals"
        },
        {
          "name": "string.quoted.double.go",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.go",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.go",
          "begin": "`",
          "end": "`"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#goCode"
            }
          ]
        },
        {
          "include": "source.go"
        }
      ]
    },
    "signals": {
      "patterns": [
        {
          "name": "variable.other.signal.gx",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "goLine": {
      "patterns": [
        {
          "include": "#signals"
        },
        {
          "name": "string.quoted.double.go",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.raw.go",
          "match": "`[^`]*`"
        },
        {
          "include": "source.go"
        }
      ]
    }
  }
}
