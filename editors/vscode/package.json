{
  "name": "gx-vscode",
  "displayName": "Gx",
  "description": "Gx language support: diagnostics, completion, formatting and the dev server.",
  "version": "0.1.0",
  "publisher": "alternayte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alternayte/gx"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:gx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gx",
        "aliases": [
          "Gx",
          "gx"
        ],
        "extensions": [
          ".gx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gx",
        "scopeName": "source.gx",
        "path": "./syntaxes/gx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.go": "go",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript"
        }
      }
    ],
    "commands": [
      {
        "command": "gx.dev",
        "title": "Gx: Run dev server",
        "category": "Gx"
      },
      {
        "command": "gx.restartServer",
        "title": "Gx: Restart language server",
        "category": "Gx"
      }
    ],
    "configuration": {
      "title": "Gx",
      "properties": {
        "gx.server.path": {
          "type": "string",
          "default": "gx",
          "description": "Path of the gx binary that runs `gx lsp`."
        },
        "gx.dev.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for `gx dev`."
        }
      }
    },
    "configurationDefaults": {
      "[gx]": {
        "editor.defaultFormatter": "alternayte.gx-vscode",
        "editor.formatOnSave": true
      }
    },
    "taskDefinitions": [
      {
        "type": "gx",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The gx command to run, for example dev."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments."
          }
        }
      }
    ]
  },
  "scripts": {
    "smoke": "node ./test/run.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0"
  }
}
