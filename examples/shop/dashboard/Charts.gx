package dashboard

import "github.com/alternayte/gx/examples/shop/dashboard/route"
import "github.com/alternayte/gx/examples/shop/ui/sl"

props {
  Revenue []Point
  Round   int = 0
}

<div #panel class="rounded-xl border border-border bg-card p-4 text-card-foreground" data-round={p.Round}>
  {/* Two web components from npm: gx wc pin wrote the typed tags of ui/sl. */}
  <sl.Badge variant="primary" pill>Round {p.Round}</sl.Badge>
  <sl.Details summary="About these numbers">The numbers follow the round.</sl.Details>
  <BarChart round={p.Round} data={p.Revenue} load="eager" />
  <Sparkline data={p.Revenue} load="idle" />
  <button class="mt-3 rounded-md bg-primary px-3 py-1.5 text-sm text-primary-foreground" on:click={route.Refresh{Round: p.Round + 1}}>Refresh</button>
</div>
