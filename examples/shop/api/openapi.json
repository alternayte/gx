    "/basket/qty/{sku}": {
      "post": {
        "description": "Sets the quantity of one line of the basket. A page gets the fragments that changed, and a JSON client gets the totals.",
        "operationId": "basket_set_qty",
        "parameters": [
          {
            "in": "path",
            "name": "sku",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "qty": {
                    "maximum": 99,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
