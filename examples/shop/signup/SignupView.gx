package signup

import (
  "github.com/alternayte/gx/examples/shop/signup/route"
  "github.com/alternayte/gx/examples/shop/ui"
)

props {
  F route.SignupForm
}

<gx.Head title="Gx shop signup" />
<h1>Sign up</h1>
<form {...p.F.Attrs()}>
  if p.F.Email.Error != "" || p.F.Age.Error != "" || p.F.Terms.Error != "" || p.F.Avatar.Error != "" || p.F.Address.Street.Error != "" {
    <div id="signup-errors" data-gx-error-summary tabindex="-1" role="alert">
      <p>Fix the errors below.</p>
    </div>
  }
  <ui.TextField label="Email" field={p.F.Email} type="email" validate="blur" hint="We never share it." />
  <ui.TextField label="Age" field={p.F.Age} type="number" validate="input" />
  <ui.TextField label="Street" field={p.F.Address.Street} type="text" />
  <ui.Checkbox field={p.F.Terms}>I accept the terms</ui.Checkbox>
  <ui.FileField label="Avatar" field={p.F.Avatar} />
  <fieldset>
    <legend>Shipping addresses</legend>
    {addressList(p.F.Addresses)}
    {addButton()}
  </fieldset>
  <button type="submit">Create account</button>
</form>
