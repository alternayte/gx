package shop

import dashboardroute "github.com/alternayte/gx/examples/shop/dashboard/route"
import "github.com/alternayte/gx/examples/shop/route"
import signuproute "github.com/alternayte/gx/examples/shop/signup/route"
import "github.com/alternayte/gx/examples/shop/ui/toast"

props {
  Children gx.Node
}

<gx.Head title="Gx shop" bodyClass="bg-background text-foreground" />
<header class="border-b border-border">
  <nav class="mx-auto flex max-w-3xl items-center gap-4 p-4 text-sm">
    <a href={route.Home{}}>Home</a>
    <a href={route.About{}}>About</a>
    <a href={signuproute.Page{}}>Sign up</a>
    <a href={dashboardroute.Page{}}>Dashboard</a>
  </nav>
</header>
<main class="mx-auto max-w-3xl p-4">{p.Children}</main>
<toast.Toaster />
