package shop

import (
  "github.com/alternayte/gx/examples/shop/route"
  signuproute "github.com/alternayte/gx/examples/shop/signup/route"
)

props {
  Children gx.Node
}

<gx.Head title="Gx shop" />
<header class="border-b border-border">
  <nav class="mx-auto flex max-w-3xl items-center gap-4 p-4 text-sm">
    <a href={route.Home{}}>Home</a>
    <a href={route.About{}}>About</a>
    <a href={signuproute.Page{}}>Sign up</a>
  </nav>
</header>
<main class="mx-auto max-w-3xl p-4">{p.Children}</main>
<div id="gx-toaster" aria-live="polite" aria-atomic="true"></div>
