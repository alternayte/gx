package field

props {
  Variant  Variant  = Legend
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<legend data-slot="field-legend" data-variant={p.variant()} class={gx.Cx("mb-3 font-medium data-[variant=legend]:text-base data-[variant=label]:text-sm", p.Class)} {...p.Attrs}>{p.Children}</legend>
