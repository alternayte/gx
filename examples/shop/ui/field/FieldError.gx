package field

props {
  // Errors holds the error messages. Empty and repeated messages do not show; two or more
  // show as a list.
  Errors   []string = nil
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the content of the error. It replaces Errors.
  Children gx.Node = nil
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

if p.Children != nil || len(p.messages()) > 0 {
  <div role="alert" data-slot="field-error" class={gx.Cx("text-sm font-normal text-destructive", p.Class)} {...p.Attrs}>
    if p.Children != nil {
      {p.Children}
    } else if len(p.messages()) == 1 {
      {p.messages()[0]}
    } else {
      <ul class="ml-4 flex list-disc flex-col gap-1">
        for _, message := range p.messages() {
          <li>{message}</li>
        }
      </ul>
    }
  </div>
}
