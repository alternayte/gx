package alert

props {
  Variant  Variant  = Default
  Title    string   = ""
  Icon     gx.Node  = nil
  Class    string   = ""
  Children gx.Node  = nil
  Attrs    gx.Attrs = nil
}

<div role="alert" class={p.class()} {...p.Attrs}>
  if p.Icon != nil {
    <span class="mt-0.5 [&>svg]:size-4"> {p.Icon} </span>
  }
  <div class="grid gap-1">
    if p.Title != "" {
      <p class="font-medium">{p.Title}</p>
    }
    if p.Children != nil {
      <div class="text-sm [&_p]:leading-relaxed">{p.Children}</div>
    }
  </div>
</div>
