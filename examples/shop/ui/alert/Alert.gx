package alert

props {
  // Variant sets the tone: Default or Destructive.
  Variant  Variant = Default
  // Title is the heading of the alert. An empty value renders no heading.
  Title    string = ""
  // Icon is an svg icon shown in the column before the text. A nil value renders no icon column.
  Icon     gx.Node = nil
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the content of the alert description. A nil value renders no description.
  Children gx.Node = nil
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

<div data-slot="alert" role="alert" class={p.class()} {...p.Attrs}>
  if p.Icon != nil {
    {p.Icon}
  }
  if p.Title != "" {
    <div data-slot="alert-title" class="col-start-2 line-clamp-1 min-h-4 font-medium tracking-tight">{p.Title}</div>
  }
  if p.Children != nil {
    <div data-slot="alert-description" class="col-start-2 grid justify-items-start gap-1 text-sm text-muted-foreground [&_p]:leading-relaxed">{p.Children}</div>
  }
</div>
