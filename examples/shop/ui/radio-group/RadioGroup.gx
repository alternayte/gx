package radiogroup

props {
  Name        string      = ""
  Orientation Orientation = Vertical
  Label       string      = ""
  Class       string      = ""
  Children    gx.Node
  Attrs       gx.Attrs    = nil
}

<div role="radiogroup" aria-label={p.Label} aria-orientation={p.orientation()} class={gx.Cx("grid gap-3", orientationClass[p.orientation()], p.Class)} {...p.Attrs}>{p.Children}</div>
