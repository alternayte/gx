package empty

props {
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<div data-slot="empty" class={gx.Cx("flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed p-6 text-center text-balance md:p-12", p.Class)} {...p.Attrs}>{p.Children}</div>
