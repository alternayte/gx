package empty

props {
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the content of the header: the media, the title and the description.
  Children gx.Node
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

<div data-slot="empty-header" class={gx.Cx("flex max-w-sm flex-col items-center gap-2 text-center", p.Class)} {...p.Attrs}>{p.Children}</div>
