package toast

props {
  Class    string   = ""
  Children gx.Node  = nil
  Attrs    gx.Attrs = nil
}

<div id="gx-toaster" role="region" aria-label="Notifications" aria-live="polite" data-gx-toaster class={gx.Cx("fixed right-4 bottom-4 z-50 flex w-[356px] max-w-[calc(100vw-2rem)] flex-col gap-3", p.Class)} {...p.Attrs}>{p.Children}</div>
