package table

props {
  // Class adds classes to the table element.
  Class    string = ""
  // Children is the content of the table: the caption, header, body and footer.
  Children gx.Node
  // Attrs adds HTML attributes to the table element.
  Attrs    gx.Attrs = nil
}

<div data-slot="table-container" class="relative w-full overflow-x-auto">
  <table data-slot="table" class={gx.Cx("w-full caption-bottom text-sm", p.Class)} {...p.Attrs}>{p.Children}</table>
</div>
