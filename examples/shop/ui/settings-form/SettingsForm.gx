package settingsform

import (
	"github.com/alternayte/gx/examples/shop/ui/button"
	"github.com/alternayte/gx/examples/shop/ui/card"
	"github.com/alternayte/gx/examples/shop/ui/field"
	"github.com/alternayte/gx/examples/shop/ui/input"
	"github.com/alternayte/gx/examples/shop/ui/separator"
	switches "github.com/alternayte/gx/examples/shop/ui/switch"
)

props {
  Action gx.URL = ""
}

<div class="mx-auto flex w-full max-w-2xl flex-col gap-6">
  <form method="post" action={p.Action} class="flex flex-col gap-6">
    <card.Card title="Profile" description="Your public name and email.">
      <div class="flex flex-col gap-4">
        <field.Field>
          <field.FieldLabel for="name">Name</field.FieldLabel>
          <input.Input id="name" name="name" type="text" />
        </field.Field>
        <field.Field>
          <field.FieldLabel for="email">Email</field.FieldLabel>
          <input.Input id="email" name="email" type="email" />
        </field.Field>
      </div>
    </card.Card>
    <card.Card title="Notifications" description="Choose what reaches your inbox.">
      <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between gap-4">
          <field.Field>
            <field.FieldLabel>Product news</field.FieldLabel>
            <field.FieldDescription>One message each month.</field.FieldDescription>
          </field.Field>
          <switches.Switch name="news" />
        </div>
        <separator.Separator />
        <div class="flex items-center justify-between gap-4">
          <field.Field>
            <field.FieldLabel>Security alerts</field.FieldLabel>
            <field.FieldDescription>Sign-in and password changes.</field.FieldDescription>
          </field.Field>
          <switches.Switch name="alerts" checked={true} />
        </div>
      </div>
    </card.Card>
    <div class="flex justify-end">
      <button.Button type="submit">Save changes</button.Button>
    </div>
  </form>
</div>
