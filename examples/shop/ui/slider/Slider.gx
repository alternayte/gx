package slider

props {
  Name  string   = ""
  Min   int      = 0
  Max   int      = 100
  Value int      = 0
  Step  int      = 1
  Label string   = ""
  Class string   = ""
  Attrs gx.Attrs = nil
}

<input type="range" name={p.Name} min={p.Min} max={p.Max} value={p.Value} step={p.Step} aria-label={p.Label} class={gx.Cx("h-2 w-full cursor-pointer appearance-none rounded-full bg-muted accent-primary", p.Class)} {...p.Attrs} />
