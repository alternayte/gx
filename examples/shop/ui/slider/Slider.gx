package slider

props {
  Orientation Orientation = Horizontal
  Name        string      = ""
  Min         int         = 0
  Max         int         = 100
  Value       int         = 0
  Step        int         = 1
  Label       string      = ""
  Disabled    bool        = false
  Class       string      = ""
  Attrs       gx.Attrs    = nil
}

<input type="range" name={p.Name} min={p.min()} max={p.max()} value={p.Value} step={p.step()} aria-label={p.Label} disabled={p.Disabled} data-gx-behavior style={p.fill()} class={p.class()} {...p.Attrs} />
