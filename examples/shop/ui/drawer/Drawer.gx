package drawer

props {
  Id          string
  Title       string   = ""
  Description string   = ""
  Trigger     gx.Node  = nil
  Footer      gx.Node  = nil
  Open        bool     = false
  Class       string   = ""
  Children    gx.Node  = nil
  Attrs       gx.Attrs = nil
}

<span class="contents">
  if p.Trigger != nil {
    <span data-gx-open={"#" + p.Id} class="contents">{p.Trigger}</span>
  }
  <dialog id={p.Id} open={p.Open} data-gx-dismiss class={gx.Cx("fixed inset-x-0 bottom-0 top-auto m-0 flex w-full flex-col gap-4 rounded-t-xl border border-border bg-card p-6 text-card-foreground shadow-lg backdrop:bg-black/50", p.Class)} {...p.Attrs}>
    <div class="mx-auto h-1.5 w-12 rounded-full bg-muted"></div>
    <div class="flex flex-col gap-1.5 text-center sm:text-left">
      if p.Title != "" {
        <h2 class="text-lg leading-none font-semibold">{p.Title}</h2>
      }
      if p.Description != "" {
        <p class="text-sm text-muted-foreground">{p.Description}</p>
      }
    </div>
    if p.Children != nil {
      <div class="text-sm">{p.Children}</div>
    }
    if p.Footer != nil {
      <div class="flex flex-col gap-2">{p.Footer}</div>
    }
  </dialog>
</span>
