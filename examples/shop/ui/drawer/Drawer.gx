package drawer

props {
  Id          string
  Title       string   = ""
  Description string   = ""
  Trigger     gx.Node  = nil
  Footer      gx.Node  = nil
  Open        bool     = false
  Class       string   = ""
  Children    gx.Node  = nil
  Attrs       gx.Attrs = nil
}

<span class="contents">
  if p.Trigger != nil {
    <span data-gx-open={"#" + p.Id} class="contents">{p.Trigger}</span>
  }
  <dialog id={p.Id} open={p.Open} data-gx-dismiss class={gx.Cx("fixed inset-x-0 bottom-0 top-auto m-0 w-full max-w-none rounded-t-lg border border-border bg-background text-card-foreground shadow-lg backdrop:bg-black/50", p.Class)} {...p.Attrs}>
    <div class="flex flex-col">
      <div class="mx-auto mt-4 h-2 w-[100px] shrink-0 rounded-full bg-muted"></div>
      <div class="flex flex-col gap-0.5 p-4 text-center md:gap-1.5 md:text-left">
        if p.Title != "" {
          <h2 class="font-semibold">{p.Title}</h2>
        }
        if p.Description != "" {
          <p class="text-sm text-muted-foreground">{p.Description}</p>
        }
      </div>
      if p.Children != nil {
        <div class="p-4 pt-0 text-sm">{p.Children}</div>
      }
      if p.Footer != nil {
        <div class="mt-auto flex flex-col gap-2 p-4">{p.Footer}</div>
      }
    </div>
  </dialog>
</span>
