package accordion

props {
  Name     string
  Title    string
  Open     bool     = false
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<details name={p.Name} open={p.Open} class={gx.Cx("group border-b border-border", p.Class)} {...p.Attrs}>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm font-medium [&::-webkit-details-marker]:hidden">
    {p.Title}
    <span class="text-muted-foreground transition-transform group-open:rotate-45">+</span>
  </summary>
  <div class="pb-4 text-sm">{p.Children}</div>
</details>
