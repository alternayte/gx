package breadcrumb

import "github.com/alternayte/gx/examples/shop/ui/icons"

props {
  Class    string   = ""
  Children gx.Node  = nil
  Attrs    gx.Attrs = nil
}

<li data-slot="breadcrumb-separator" role="presentation" aria-hidden="true" class={gx.Cx("[&>svg]:size-3.5", p.Class)} {...p.Attrs}>
  if p.Children != nil {
    {p.Children}
  } else {
    <icons.ChevronRight />
  }
</li>
