package togglegroup

props {
  Name     string
  Value    string
  Checked  bool     = false
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<label class={gx.Cx("inline-flex h-7 items-center justify-center gap-1 rounded-sm px-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground has-[:checked]:bg-accent has-[:checked]:text-accent-foreground", p.Class)} {...p.Attrs}>
  <input type="radio" name={p.Name} value={p.Value} checked={p.Checked} class="peer sr-only" />
  {p.Children}
</label>
