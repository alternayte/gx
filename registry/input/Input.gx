package input

props {
  Id          string   = ""
  Type        string   = "text"
  Name        string   = ""
  Value       string   = ""
  Placeholder string   = ""
  Class       string   = ""
  Attrs       gx.Attrs = nil
}

<input id={p.Id} type={p.inputType()} name={p.Name} value={p.Value} placeholder={p.Placeholder} data-slot="input" class={gx.Cx(Class, p.Class)} {...p.Attrs} />
