package starlight

props {
  // Headings holds the entries of the table of contents, below the entry "Overview" for the
  // top of the page.
  Headings []Heading
}

<div class="sl-mobile-toc">
  <nav data-gx-toc aria-labelledby="sl-on-this-page-mobile">
    <details data-gx-toc-menu>
      <summary id="sl-on-this-page-mobile">
        <span class="sl-toggle">
          On this page
          {icon("right-caret", "sl-caret")}
        </span>
        <span class="sl-display-current" data-gx-toc-current></span>
      </summary>
      <div class="sl-dropdown">
        <ul class="sl-toc-list">
          <li>
            <a href="#_top" data-gx-toc-target="_top" data-level="2"><span>Overview</span></a>
          </li>
          for _, h := range p.Headings {
            <li>
              <a href={gx.URL("#" + h.ID)} data-gx-toc-target={h.ID} data-level={h.Level}><span>{h.Text}</span></a>
            </li>
          }
        </ul>
      </div>
    </details>
  </nav>
</div>
