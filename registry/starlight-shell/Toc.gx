package starlight

props {
  // Headings holds the entries of the table of contents, below the entry "Overview" for the
  // top of the page.
  Headings []Heading
}

<nav class="sl-toc" data-gx-toc aria-labelledby="sl-on-this-page">
  <h2 id="sl-on-this-page">On this page</h2>
  <ul class="sl-toc-list">
    <li>
      <a href="#_top" data-gx-toc-target="_top" data-level="2"><span>Overview</span></a>
    </li>
    for _, h := range p.Headings {
      <li>
        <a href={gx.URL("#" + h.ID)} data-gx-toc-target={h.ID} data-level={h.Level}><span>{h.Text}</span></a>
      </li>
    }
  </ul>
</nav>
