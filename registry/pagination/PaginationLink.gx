package pagination

import "github.com/alternayte/gx/registry/button"

props {
  Href     gx.URL
  Active   bool        = false
  Size     button.Size = button.Icon
  Class    string      = ""
  Children gx.Node
  Attrs    gx.Attrs    = nil
}

<a href={p.Href} data-slot="pagination-link" class={p.class()} {...p.attrs()}>{p.Children}</a>
