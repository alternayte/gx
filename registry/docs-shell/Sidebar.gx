package shell

props {
  // Nav is the sidebar model: the groups and their items.
  Nav  Nav
  // Path is the site path of the current page.
  // A nested item that holds the page starts open.
  Path string
}

<aside id="gx-sidebar" class="gx-sidebar w-64 shrink-0 border-r border-border" data-gx-sidebar>
  <nav aria-label="Docs" class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto py-6 pr-4">
    for _, g := range p.Nav.Groups {
      <SidebarGroup group={g} path={p.Path} />
    }
  </nav>
</aside>
