package popover

props {
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the text of the title.
  Children gx.Node
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

<div class={gx.Cx("font-medium", p.Class)} {...p.Attrs}>{p.Children}</div>
