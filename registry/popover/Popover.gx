package popover

props {
  // Id is the id of the root element. The trigger opens the popover by this id.
  Id       string
  // Align sets the edge of the trigger that the popover lines up with: Center, Start or End.
  Align    Align = Center
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the content of the popover.
  Children gx.Node
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

<div id={p.Id} popover="auto" data-gx-dismiss data-gx-place={p.place()} style={p.style()} class={gx.Cx("z-50 w-72 rounded-md border border-border bg-popover p-4 text-popover-foreground shadow-md outline-hidden", motionClass, alignClass[p.align()], p.Class)} {...p.Attrs}>{p.Children}</div>
