package popover

props {
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the text of the description.
  Children gx.Node
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

<p class={gx.Cx("text-muted-foreground", p.Class)} {...p.Attrs}>{p.Children}</p>
