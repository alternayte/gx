package radiogroup

props {
  Name     string   = ""
  Value    string   = ""
  Checked  bool     = false
  Label    string   = ""
  Class    string   = ""
  Children gx.Node  = nil
  Attrs    gx.Attrs = nil
}

<label class={gx.Cx("flex items-center gap-2 text-sm", p.Class)} {...p.Attrs}>
  <input type="radio" name={p.Name} value={p.Value} checked={p.Checked} class="size-4 accent-primary" />
  if p.Label != "" {
    <span>{p.Label}</span>
  }
  if p.Children != nil {
    <span>{p.Children}</span>
  }
</label>
