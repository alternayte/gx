package field

props {
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<div data-slot="field-group" class={gx.Cx("group/field-group @container/field-group flex w-full flex-col gap-7 data-[slot=checkbox-group]:gap-3 [&>[data-slot=field-group]]:gap-4", p.Class)} {...p.Attrs}>{p.Children}</div>
