package breadcrumb

import "github.com/alternayte/gx/registry/icons"

props {
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the content of the separator. A nil value renders a chevron icon.
  Children gx.Node = nil
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

<li data-slot="breadcrumb-separator" role="presentation" aria-hidden="true" class={gx.Cx("[&>svg]:size-3.5", p.Class)} {...p.Attrs}>
  if p.Children != nil {
    {p.Children}
  } else {
    <icons.ChevronRight />
  }
</li>
