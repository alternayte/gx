package tabs

props {
  // Label is the label of the trigger that shows this panel.
  Label    string
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the content of the panel.
  Children gx.Node
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

<div role="tabpanel" tabindex="0" data-gx-tab-panel={p.Label} class={gx.Cx("flex-1 outline-none", p.Class)} {...p.Attrs}>{p.Children}</div>
