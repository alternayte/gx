package progress

props {
  // Value is the current value. The bar clamps it to the range 0 to Max.
  Value int = 0
  // Max is the maximum value. A zero value is 100.
  Max   int = 100
  // Label is the accessible name of the progress bar.
  Label string = ""
  // Class adds classes to the root element.
  Class string = ""
  // Attrs adds HTML attributes to the root element.
  Attrs gx.Attrs = nil
}

<div role="progressbar" aria-valuemin={0} aria-valuemax={p.max()} aria-valuenow={p.Value} aria-label={p.Label} class={gx.Cx("relative h-2 w-full overflow-hidden rounded-full bg-primary/20", p.Class)} {...p.Attrs}>
  <div class="h-full w-full flex-1 bg-primary transition-all motion-reduce:transition-none" style={gx.Style("transform: translateX(-" + p.offset() + "%)")}></div>
</div>
