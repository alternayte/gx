package sheet

props {
  Id          string
  Side        Side     = Right
  Title       string   = ""
  Description string   = ""
  Trigger     gx.Node  = nil
  Footer      gx.Node  = nil
  Open        bool     = false
  Class       string   = ""
  Children    gx.Node  = nil
  Attrs       gx.Attrs = nil
}

<span class="contents">
  if p.Trigger != nil {
    <span data-gx-open={"#" + p.Id} class="contents">{p.Trigger}</span>
  }
  <dialog id={p.Id} open={p.Open} data-gx-dismiss class={gx.Cx("fixed m-0 border border-border bg-background text-card-foreground shadow-lg backdrop:bg-black/50", p.sideClass(), p.Class)} {...p.Attrs}>
    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-1.5 p-4">
        <div class="flex items-start justify-between gap-4">
          <div class="flex flex-col gap-1.5">
            if p.Title != "" {
              <h2 class="text-lg leading-none font-semibold">{p.Title}</h2>
            }
            if p.Description != "" {
              <p class="text-sm text-muted-foreground">{p.Description}</p>
            }
          </div>
          <button type="button" data-gx-close aria-label="Close" class="rounded-md p-1 text-muted-foreground hover:bg-accent hover:text-accent-foreground">×</button>
        </div>
      </div>
      if p.Children != nil {
        <div class="flex-1 p-4 pt-0 text-sm">{p.Children}</div>
      }
      if p.Footer != nil {
        <div class="flex flex-col-reverse gap-2 p-4 pt-0 sm:flex-row sm:justify-end">{p.Footer}</div>
      }
    </div>
  </dialog>
</span>
