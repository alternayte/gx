package empty

props {
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<div data-slot="empty-description" class={gx.Cx("text-sm leading-relaxed text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary", p.Class)} {...p.Attrs}>{p.Children}</div>
