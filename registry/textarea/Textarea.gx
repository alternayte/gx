package textarea

props {
  // Name is the form field name.
  Name        string = ""
  // Value is the text of the textarea.
  Value       string = ""
  // Placeholder is the text that shows while the textarea is empty.
  Placeholder string = ""
  // Rows is the rows attribute. A value of zero or less renders no attribute.
  Rows        int = 0
  // Class adds classes to the root element.
  Class       string = ""
  // Attrs adds HTML attributes to the root element.
  Attrs       gx.Attrs = nil
}

<textarea name={p.Name} placeholder={p.Placeholder} data-slot="textarea" class={gx.Cx(Class, p.Class)} {...p.attrs()}>{p.Value}</textarea>
