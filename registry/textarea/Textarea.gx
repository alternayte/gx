package textarea

props {
  Name        string   = ""
  Value       string   = ""
  Placeholder string   = ""
  Rows        int      = 0
  Class       string   = ""
  Attrs       gx.Attrs = nil
}

<textarea name={p.Name} placeholder={p.Placeholder} data-slot="textarea" class={gx.Cx(Class, p.Class)} {...p.attrs()}>{p.Value}</textarea>
