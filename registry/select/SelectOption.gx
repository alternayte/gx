package selectbox

props {
  // Value is the value the form submits when the option is selected.
  Value    string = ""
  // Selected selects the option for the first render.
  Selected bool = false
  // Disabled disables the option.
  Disabled bool = false
  // Children is the option label.
  Children gx.Node
}

<option value={p.Value} selected={p.Selected} disabled={p.Disabled}>{p.Children}</option>
