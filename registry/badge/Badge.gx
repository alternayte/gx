package badge

props {
  // Variant sets the visual style: Default, Secondary, Destructive, Outline, Ghost or Link.
  Variant  Variant = Default
  // Href is the URL of the link. A non-empty value renders the badge as an a element, not a span.
  Href     gx.URL = ""
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the badge label.
  Children gx.Node
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

if p.Href != "" {
  <a href={p.Href} data-slot="badge" data-variant={p.variant()} class={p.class()} {...p.Attrs}>{p.Children}</a>
} else {
  <span data-slot="badge" data-variant={p.variant()} class={p.class()} {...p.Attrs}>{p.Children}</span>
}
