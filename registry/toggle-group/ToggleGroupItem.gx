package togglegroup

props {
  Name     string
  Value    string
  Checked  bool     = false
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<label class={gx.Cx("inline-flex h-9 min-w-9 items-center justify-center gap-2 rounded-none px-2 text-sm font-medium transition-colors outline-none first:rounded-l-md last:rounded-r-md hover:bg-muted hover:text-muted-foreground has-[:checked]:bg-accent has-[:checked]:text-accent-foreground has-[:focus-visible]:z-10 has-[:focus-visible]:ring-[3px] has-[:focus-visible]:ring-ring/50", p.Class)} {...p.Attrs}>
  <input type="radio" name={p.Name} value={p.Value} checked={p.Checked} class="peer sr-only" />
  {p.Children}
</label>
