package sidebar

props {
  // Id is the id of the root element.
  // SidebarTrigger shows and hides the sidebar with the id gx-sidebar.
  Id       string
  // Side sets the edge of the page that holds the sidebar: Left or Right.
  Side     Side = Left
  // Class adds classes to the root element.
  Class    string = ""
  // Children is the content of the sidebar: the header, content and footer.
  Children gx.Node
  // Attrs adds HTML attributes to the root element.
  Attrs    gx.Attrs = nil
}

<aside id={p.Id} data-gx-sidebar data-slot="sidebar" data-side={p.side()} class={gx.Cx("flex w-64 shrink-0 flex-col bg-sidebar text-sidebar-foreground data-[side=left]:border-r data-[side=right]:border-l", p.Class)} {...p.Attrs}>{p.Children}</aside>
