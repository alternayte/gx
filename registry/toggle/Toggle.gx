package toggle

props {
  Variant  Variant  = Default
  Size     Size     = Md
  Name     string   = ""
  Value    string   = "on"
  Pressed  bool     = false
  Disabled bool     = false
  Invalid  bool     = false
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<label class={p.class()} {...p.Attrs}>
  <input type="checkbox" name={p.Name} value={p.Value} checked={p.Pressed} disabled={p.Disabled} aria-invalid={p.invalid()} class="peer sr-only" />
  {p.Children}
</label>
