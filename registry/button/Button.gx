package button

props {
  Variant  Variant  = Default
  Size     Size     = Md
  Type     string   = "button"
  Class    string   = ""
  Children gx.Node
  Attrs    gx.Attrs = nil
}

<button data-slot="button" data-variant={p.variant()} data-size={p.size()} type={p.typeAttr()} class={Class(p.Variant, p.Size, p.Class)} {...p.Attrs}>{p.Children}</button>
